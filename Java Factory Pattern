import java.util.*;
import java.security.*;

interface Food {
    public String getType();
}

class Pizza implements Food {
    public String getType() {
        return "Someone ordered Fast Food!";
    }
}

class Cake implements Food {
    public String getType() {
        return "Someone ordered a Dessert!";
    }
}

class FoodFactory {
    public Food getFood(String order) {
        if (order.equalsIgnoreCase("pizza")) {
            return new Pizza();
        } else if (order.equalsIgnoreCase("cake")) {
            return new Cake();
        }
        return null;
    }
}

public class Solution {

    public static void main(String[] args) {
        DoBefore.notifyBefore();
        try {
            Scanner sc = new Scanner(System.in);
            // Creating the factory object
            FoodFactory foodFactory = new FoodFactory();

            // Factory instantiates an object based on input order
            Food food = foodFactory.getFood(sc.nextLine());

            System.out.println("The factory returned class " + food.getClass().getSimpleName());
            System.out.println(food.getType());
        } catch (ExitTrappedException e) {
            System.out.println("Forbidden " + e.getForbiddenExitCode());
        }
    }
}

class DoBefore {
    public static void notifyBefore() {
        // Helper setup for HackerRank safety check executions
    }
}

class ExitTrappedException extends SecurityException {
    private static final long serialVersionUID = 1L;

    public int getForbiddenExitCode() {
        return 0;
    }
}
